#!/usr/bin/env bash
set -euo pipefail

# Validate JSON files against their $schema references
# Usage: validate-json [file...]
# If no files provided, finds all JSON files in current directory

failed=0

validate_file() {
  local file="$1"
  local schema
  schema=$(jq -r '.["$schema"] // empty' "$file" 2>/dev/null)

  if [ -n "$schema" ]; then
    # Resolve relative schema paths
    case "$schema" in
      ../*|./*)
        local dir
        dir=$(dirname "$file")
        schema=$(cd "$dir" && realpath "$schema")
        ;;
    esac
    echo "Validating $file against $schema"
    if ! jv "$schema" "$file"; then
      return 1
    fi
  fi
  return 0
}

if [ $# -gt 0 ]; then
  # Validate specific files
  for file in "$@"; do
    if ! validate_file "$file"; then
      failed=1
    fi
  done
else
  # Find and validate all JSON files
  while IFS= read -r -d '' file; do
    if ! validate_file "$file"; then
      failed=1
    fi
  done < <(find . -name '*.json' -not -path './.git/*' -print0)
fi

exit $failed
